# Paper companion repo: ignore large/derived artifacts

# Required exclusions (not versioned on remote)
*.pdf
**/*.pdf
*.rds
**/*.rds
tables/*
!tables/.gitkeep
figures/*
!figures/.gitkeep

# Derived metafloat inputs (regenerated by table4.R)
wt_metafloat_*_input.csv
wt_metafloat_export.log

# Common derived / local files
.DS_Store
*.Rhistory
.Rproj.user/
*.RData
*.RDataTmp
